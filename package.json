{
  "name": "opencode-auto-memory",
  "version": "3.0.0",
  "description": "Local notes and a full-text conversation index for opencode, in one SQLite file",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Real-Gecko/opencode-auto-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Real-Gecko/opencode-auto-memory/issues"
  },
  "homepage": "https://github.com/Real-Gecko/opencode-auto-memory#readme",
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "sqlite",
    "fts5"
  ],
  "author": "RealGecko",
  "license": "MIT",
  "devDependencies": {
    "@opencode/plugin": "2.0.11",
    "@types/bun": "1.4.1",
    "typescript": "5.9.3"
  },
  "opencode": {
    "type": "plugin"
  }
}
